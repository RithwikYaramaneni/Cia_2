pipeline {
    agent any

    environment {
        IMAGE_NAME = 'attendify'
        NAMESPACE = 'attendify'
        KUBE_CONTEXT = 'docker-desktop'
    }

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'CANARY_ACTION',
            choices: ['deploy', 'promote', 'rollback'],
            description: 'Deploy a canary, promote it to production, or roll back to stable'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and test') {
            steps {
                dir('Cia_2') {
                    sh 'mvn -B clean verify'
                }
            }
            post {
                always {
                    junit testResults: 'Cia_2/target/surefire-reports/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Build Docker image') {
            when {
                expression { params.CANARY_ACTION == 'deploy' }
            }
            steps {
                dir('Cia_2') {
                    sh '''
                        docker build --tag "attendify:${BUILD_NUMBER}" .
                        docker tag "attendify:${BUILD_NUMBER}" attendify:canary
                    '''
                }
            }
        }

        stage('Deploy canary') {
            when {
                expression { params.CANARY_ACTION == 'deploy' }
            }
            steps {
                dir('Cia_2') {
                    sh '''
                        kubectl config use-context "${KUBE_CONTEXT}"
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/deployment.yaml
                        kubectl apply -f k8s/service.yaml
                        kubectl apply -f k8s/deployment-canary.yaml
                        kubectl apply -f k8s/service-canary.yaml
                        kubectl -n "${NAMESPACE}" rollout status \
                          deployment/attendify-canary --timeout=120s
                    '''
                }
            }
        }

        stage('Promote canary') {
            when {
                expression { params.CANARY_ACTION == 'promote' }
            }
            steps {
                dir('Cia_2') {
                    sh '''
                        kubectl config use-context "${KUBE_CONTEXT}"
                        kubectl -n "${NAMESPACE}" rollout status \
                          deployment/attendify-canary --timeout=120s
                        kubectl -n "${NAMESPACE}" patch service attendify \
                          --type merge \
                          --patch '{"spec":{"selector":{"app":"attendify","version":"canary"}}}'
                        kubectl -n "${NAMESPACE}" get deployment,pods,service
                    '''
                }
            }
        }

        stage('Rollback canary') {
            when {
                expression { params.CANARY_ACTION == 'rollback' }
            }
            steps {
                dir('Cia_2') {
                    sh '''
                        kubectl config use-context "${KUBE_CONTEXT}"
                        kubectl -n "${NAMESPACE}" patch service attendify \
                          --type merge \
                          --patch '{"spec":{"selector":{"app":"attendify","version":"stable"}}}'
                        kubectl -n "${NAMESPACE}" delete deployment attendify-canary \
                          --ignore-not-found
                        kubectl -n "${NAMESPACE}" delete service attendify-canary \
                          --ignore-not-found
                        kubectl -n "${NAMESPACE}" get deployment,pods,service
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Attendify passed tests and was deployed successfully.'
        }
        failure {
            echo 'Attendify pipeline failed. Review the stage logs and test report.'
        }
    }
}
